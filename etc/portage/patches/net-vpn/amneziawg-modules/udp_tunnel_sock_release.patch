From 2105b09fcc603ef4c3d1e2cd1b8b5a7c0b338dde Mon Sep 17 00:00:00 2001
From: VaisVaisov <vais55.va@gmail.com>
Date: Mon, 17 Aug 2026 20:35:55 +0500
Subject: [PATCH] socket: fix udp_tunnel_sock_release/setup_udp_tunnel_sock ABI
 mismatch on newer kernels

---
 src/socket.c | 34 ++++++++++++++++++++++++++++++----
 1 file changed, 30 insertions(+), 4 deletions(-)

diff --git a/src/socket.c b/src/socket.c
index 24bf1ab0..58a30973 100644
--- a/src/socket.c
+++ b/src/socket.c
@@ -370,12 +370,38 @@ static int wg_receive(struct sock *sk, struct sk_buff *skb)
 	return 0;
 }
 
+/*
+ * Some very recent kernel snapshots (not yet in an official release at the
+ * time of writing) changed udp_tunnel_sock_release()/setup_udp_tunnel_sock()
+ * to take a struct sock * instead of a struct socket *. LINUX_VERSION_CODE
+ * can't reliably gate this, since some distros (e.g. CachyOS) backport it
+ * early under an unchanged version number. Detect the real signature at
+ * compile time instead.
+ */
+static inline void wg_udp_tunnel_sock_release(struct sock *sk, struct socket *sock)
+{
+	if (__builtin_types_compatible_p(typeof(&udp_tunnel_sock_release), void (*)(struct sock *)))
+		((void (*)(struct sock *))udp_tunnel_sock_release)(sk);
+	else
+		((void (*)(struct socket *))udp_tunnel_sock_release)(sock);
+}
+
+static inline void wg_setup_udp_tunnel_sock(struct net *net, struct socket *sock,
+					     struct udp_tunnel_sock_cfg *cfg)
+{
+	if (__builtin_types_compatible_p(typeof(&setup_udp_tunnel_sock),
+					  void (*)(struct net *, struct sock *, struct udp_tunnel_sock_cfg *)))
+		((void (*)(struct net *, struct sock *, struct udp_tunnel_sock_cfg *))setup_udp_tunnel_sock)(net, sock->sk, cfg);
+	else
+		((void (*)(struct net *, struct socket *, struct udp_tunnel_sock_cfg *))setup_udp_tunnel_sock)(net, sock, cfg);
+}
+
 static void sock_free(struct sock *sock)
 {
 	if (unlikely(!sock))
 		return;
 	sk_clear_memalloc(sock);
-	udp_tunnel_sock_release(sock->sk_socket);
+	wg_udp_tunnel_sock_release(sock, sock->sk_socket);
 }
 
 static void set_sock_opts(struct socket *sock)
@@ -429,14 +455,14 @@ int wg_socket_init(struct wg_device *wg, u16 port)
 		goto out;
 	}
 	set_sock_opts(new4);
-	setup_udp_tunnel_sock(net, new4, &cfg);
+	wg_setup_udp_tunnel_sock(net, new4, &cfg);
 
 #if IS_ENABLED(CONFIG_IPV6)
 	if (ipv6_mod_enabled()) {
 		port6.local_udp_port = inet_sk(new4->sk)->inet_sport;
 		ret = udp_sock_create(net, &port6, &new6);
 		if (ret < 0) {
-			udp_tunnel_sock_release(new4);
+			wg_udp_tunnel_sock_release(new4->sk, new4);
 			if (ret == -EADDRINUSE && !port && retries++ < 100)
 				goto retry;
 			pr_err("%s: Could not create IPv6 socket\n",
@@ -444,7 +470,7 @@ int wg_socket_init(struct wg_device *wg, u16 port)
 			goto out;
 		}
 		set_sock_opts(new6);
-		setup_udp_tunnel_sock(net, new6, &cfg);
+		wg_setup_udp_tunnel_sock(net, new6, &cfg);
 	}
 #endif
