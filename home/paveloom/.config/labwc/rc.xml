<?xml version="1.0"?>
<labwc_config>
  <desktops>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>
  <keyboard>
    <default/>
    <!-- The W- prefix refers to the Super key -->
    <keybind key="W-L">
      <action name="Execute" command="swaylock" />
    </keybind>
    <keybind key="W-V" onRelease="true">
      <action name="Execute" command="xfce4-popup-clipman" />
    </keybind>

    <keybind key="Super_L" onRelease="true">
      <action name="Execute" command="xfce4-appfinder" />
    </keybind>

    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" />
    </keybind>

    <keybind key="XF86AudioMute">
        <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
        <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
        <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>

    <keybind key="XF86AudioPlay">
        <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioNext">
        <action name="Execute" command="playerctl next" />
    </keybind>
    <keybind key="XF86AudioPrev">
        <action name="Execute" command="playerctl previous" />
    </keybind>
  </keyboard>
  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>
  <windowRules>
    <windowRule identifier="foot" event="onMap">
      <action name="Maximize" direction="both"/>
    </windowRule>
  </windowRules>
</labwc_config>
